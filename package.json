{
	"name": "@nozomioai/nia",
	"version": "0.3.0",
	"type": "module",
	"description": "CLI for the Nia — search code, docs, and research from the terminal",
	"license": "Apache-2.0",
	"packageManager": "bun@1.3.10",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nozomio-labs/nia-cli.git"
	},
	"bugs": {
		"url": "https://github.com/nozomio-labs/nia-cli/issues"
	},
	"homepage": "https://github.com/nozomio-labs/nia-cli#readme",
	"keywords": [
		"cli",
		"nia",
		"search",
		"developer-tools"
	],
	"engines": {
		"bun": ">=1.3.10"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"bin": {
		"nia": "dist/cli"
	},
	"scripts": {
		"dev": "bun run src/cli.ts",
		"build": "crust build --package",
		"start": "./dist/cli",
		"check:types": "tsc --noEmit",
		"test": "bun test",
		"check": "biome check .",
		"publish": "crust build --package && crust publish && changeset tag"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@changesets/cli": "^2.30.0",
		"@crustjs/core": "0.0.15",
		"@crustjs/crust": "0.0.23",
		"@crustjs/plugins": "0.0.20",
		"@crustjs/prompts": "^0.0.10",
		"@crustjs/skills": "^0.0.21",
		"@crustjs/store": "^0.0.4",
		"@crustjs/style": "^0.0.6",
		"@types/bun": "^1.3.11",
		"nia-ai-ts": "^0.1.0",
		"typescript": "^6.0.2"
	},
	"dependencies": {
		"@nozomioai/nia-sdk": "^0.0.4",
		"chokidar": "^5.0.0",
		"just-bash": "^2.10.0"
	}
}
